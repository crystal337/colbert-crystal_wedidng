# Copy this file to .env and fill in your real values.
# See README.md for how to get each of these.

# Google Apps Script Web App URL (ends in /exec)
VITE_GAS_ENDPOINT=https://script.google.com/macros/s/XXXXXXXXXXXX/exec

# Group invite links shown after a guest submits the RSVP form
VITE_LINE_URL=https://line.me/ti/g/XXXXXXXXXX
VITE_WHATSAPP_URL=https://chat.whatsapp.com/XXXXXXXXXX
